NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://checkoutkit:checkoutkit@localhost:55432/checkoutkit
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
# dev-only placeholder keys — generate real ones per-environment, never reuse across envs
PHONE_ENCRYPTION_KEY=059e933b3af4b3d88b58dd56c285559494de4946ec267bcd5a2484870ab6580e
PHONE_HASH_KEY=dev-only-phone-hash-key-change-me-0123456789
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Deliberately a different secret from JWT_ACCESS_SECRET — merchant dashboard logins and
# shopper OTP sessions must never be able to impersonate each other's token type.
JWT_DASHBOARD_SECRET=dev-only-dashboard-jwt-secret-change-me-0123456789
JWT_DASHBOARD_TTL_SECONDS=3600
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
WEBHOOK_SECRET_ENCRYPTION_KEY=c3b8d83695a493ae14563ec861dd1842149757a5f38d7272e528ca1551731c16
# 0 = not behind a reverse proxy (safe default). Set to the real hop count only once
# deployed behind a load balancer (e.g. 1 for a single ALB/nginx in front of the API).
TRUST_PROXY_HOPS=0
OUTBOX_PUBLISH_INTERVAL_MS=5000
FAKE_GATEWAY_WEBHOOK_SECRET=dev-only-fake-gateway-secret-key
# Real Razorpay sandbox credentials — leave unset to run with only the fake gateway (every
# test does). See README for exactly which dashboard settings to pull these from.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_BASE_URL=http://localhost:5173
RECONCILIATION_INTERVAL_MS=60000
RECONCILIATION_STALE_AFTER_MS=300000
SHOPIFY_TOKEN_ENCRYPTION_KEY=c1e6b1f7af07573fb3e20a3424c967a25b3d67227f7a9e60f6a2d8ff2270b1e5
# Real Shopify Partner app credentials (issued by Shopify, not us) — leave unset to run
# with the OAuth install/callback flow unavailable (no live store exists in this
# environment to test it against). See docs/decisions/008-stage7-shopify.md.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# This one we mint ourselves and paste into the Partner dashboard's webhook config, so
# unlike the two above it has a real dev-only default and is always testable.
SHOPIFY_WEBHOOK_SECRET=dev-only-shopify-webhook-secret-key
SHOPIFY_SCOPES=read_orders,write_draft_orders
SHOPIFY_APP_URL=http://localhost:3000
