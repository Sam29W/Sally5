generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shopper {
  id             String          @id @default(uuid())
  // AES-256-GCM ciphertext (iv:tag:ciphertext, base64), never the raw number.
  phoneEncrypted String          @map("phone_encrypted")
  // HMAC-SHA256(phone) with a server-side key — deterministic, used only for lookup.
  phoneHash      String          @unique @map("phone_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  consents       ConsentRecord[]
  sessionFamilies SessionFamily[]

  @@map("shoppers")
}

model ConsentRecord {
  id        String   @id @default(uuid())
  shopperId String   @map("shopper_id")
  shopper   Shopper  @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  purpose   String
  version   String
  grantedAt DateTime @default(now()) @map("granted_at")

  @@map("consent_records")
  @@index([shopperId])
}

// One family per login; rotating refresh tokens within a family share a lineage.
// Reuse of an already-rotated token revokes the whole family.
model SessionFamily {
  id          String         @id @default(uuid())
  shopperId   String         @map("shopper_id")
  shopper     Shopper        @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  revokedAt   DateTime?      @map("revoked_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]

  @@map("session_families")
  @@index([shopperId])
}

model RefreshToken {
  id           String        @id @default(uuid())
  familyId     String        @map("family_id")
  family       SessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  // SHA-256 of the token secret — the raw token is never stored.
  tokenHash    String        @unique @map("token_hash")
  rotatedAt    DateTime?     @map("rotated_at")
  expiresAt    DateTime      @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@index([familyId])
}
