generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shopper {
  id             String          @id @default(uuid())
  // AES-256-GCM ciphertext (iv:tag:ciphertext, base64), never the raw number.
  phoneEncrypted String          @map("phone_encrypted")
  // HMAC-SHA256(phone) with a server-side key — deterministic, used only for lookup.
  phoneHash      String          @unique @map("phone_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  consents       ConsentRecord[]
  sessionFamilies SessionFamily[]
  addresses      Address[]

  @@map("shoppers")
}

model Merchant {
  id               String            @id @default(uuid())
  name             String
  createdAt        DateTime          @default(now()) @map("created_at")
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  addressShares    AddressShare[]
  cartSessions     CartSession[]
  orders           Order[]
  codRiskConfig    CodRiskConfig?

  @@map("merchants")
}

model ApiKey {
  id         String    @id @default(uuid())
  merchantId String    @map("merchant_id")
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // First 8 chars of the key secret, kept in the clear so a merchant can identify which
  // key is which in a list without ever seeing the full secret again.
  prefix     String
  // SHA-256 of the full key secret — the secret itself is shown once at creation and never
  // stored or logged.
  keyHash    String    @unique @map("key_hash")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
  @@index([merchantId])
}

model WebhookEndpoint {
  id            String   @id @default(uuid())
  merchantId    String   @map("merchant_id")
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  url           String
  // AES-256-GCM ciphertext of the signing secret (same scheme as phone encryption) — needed
  // in recoverable form to sign outgoing webhook payloads, so it's encrypted, not hashed.
  signingSecretEncrypted String @map("signing_secret_encrypted")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("webhook_endpoints")
  @@index([merchantId])
}

model Address {
  id           String         @id @default(uuid())
  shopperId    String         @map("shopper_id")
  shopper      Shopper        @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  country      String         @default("IN")
  isDefault    Boolean        @default(false) @map("is_default")
  qualityScore Int            @map("quality_score")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  shares       AddressShare[]

  @@map("addresses")
  @@index([shopperId])
}

// Explicit shopper consent for a merchant other than the one the address was first used
// with to see/reuse that address — the shared address network only shares with consent.
model AddressShare {
  id         String   @id @default(uuid())
  addressId  String   @map("address_id")
  address    Address  @relation(fields: [addressId], references: [id], onDelete: Cascade)
  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  grantedAt  DateTime @default(now()) @map("granted_at")

  @@unique([addressId, merchantId])
  @@map("address_shares")
}

model ConsentRecord {
  id        String   @id @default(uuid())
  shopperId String   @map("shopper_id")
  shopper   Shopper  @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  purpose   String
  version   String
  grantedAt DateTime @default(now()) @map("granted_at")

  @@map("consent_records")
  @@index([shopperId])
}

// One family per login; rotating refresh tokens within a family share a lineage.
// Reuse of an already-rotated token revokes the whole family.
model SessionFamily {
  id          String         @id @default(uuid())
  shopperId   String         @map("shopper_id")
  shopper     Shopper        @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  revokedAt   DateTime?      @map("revoked_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]

  @@map("session_families")
  @@index([shopperId])
}

model RefreshToken {
  id           String        @id @default(uuid())
  familyId     String        @map("family_id")
  family       SessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  // SHA-256 of the token secret — the raw token is never stored.
  tokenHash    String        @unique @map("token_hash")
  rotatedAt    DateTime?     @map("rotated_at")
  expiresAt    DateTime      @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@index([familyId])
}

model CartSession {
  id             String   @id @default(uuid())
  merchantId     String   @map("merchant_id")
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shopperId      String?  @map("shopper_id")
  // Line items as submitted: [{ sku, name, quantity, unitPriceCents }, ...].
  items          Json
  couponCode     String?  @map("coupon_code")
  subtotalCents  Int      @map("subtotal_cents")
  discountCents  Int      @map("discount_cents")
  shippingCents  Int      @map("shipping_cents")
  taxCents       Int      @map("tax_cents")
  totalCents     Int      @map("total_cents")
  createdAt      DateTime @default(now()) @map("created_at")
  orders         Order[]

  @@map("cart_sessions")
  @@index([merchantId])
}

// created -> payment_pending -> paid | cod_confirmed -> fulfilled -> delivered | rto
//   \-> cancelled (from created or payment_pending only)
// Legal transitions are enforced centrally in order-state-machine.ts, not scattered
// across callers, so there is exactly one place that can ever get this wrong.
enum OrderStatus {
  created
  payment_pending
  paid
  cod_confirmed
  fulfilled
  delivered
  rto
  cancelled
}

model Order {
  id             String       @id @default(uuid())
  merchantId     String       @map("merchant_id")
  merchant       Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cartSessionId  String       @map("cart_session_id")
  cartSession    CartSession  @relation(fields: [cartSessionId], references: [id])
  shopperId      String?      @map("shopper_id")
  status         OrderStatus  @default(created)
  totalCents     Int          @map("total_cents")
  // Scoped per-merchant (see @@unique below) — lets a merchant safely retry an order
  // creation call without ever double-creating the order.
  idempotencyKey String       @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  outboxEvents   OutboxEvent[]
  payments       Payment[]
  codRiskDecisions CodRiskDecision[]
  codRiskOutcome   CodRiskOutcome?

  @@map("orders")
  @@unique([merchantId, idempotencyKey])
  @@index([merchantId])
}

// The outbox pattern: every state-changing write to an Order inserts a row here in the
// *same* database transaction. A separate publisher step reads unpublished rows and sends
// them to Kafka, marking publishedAt on success. Because the event row and the order
// mutation commit atomically together, a crash at any point — including exactly between
// the DB commit and the Kafka publish — can never lose an event: on restart, the
// publisher simply finds the still-unpublished row and sends it (at-least-once delivery).
model OutboxEvent {
  id            String    @id @default(uuid())
  orderId       String    @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType     String    @map("event_type")
  // Event body as it will be published to Kafka.
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  @@map("outbox_events")
  @@index([publishedAt])
}

enum PaymentStatus {
  pending
  captured
  failed
  refunded
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Which PaymentGateway implementation handled this payment — "fake" in every test, the
  // real gateway's name ("razorpay") only outside tests.
  gateway          String
  // The gateway's own id for this payment — never a card/UPI number, never raw PAN. No
  // card data of any kind is ever stored here or anywhere else in this schema.
  gatewayPaymentId String        @unique @map("gateway_payment_id")
  status           PaymentStatus @default(pending)
  amountCents      Int           @map("amount_cents")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@map("payments")
  @@index([orderId])
  @@index([status])
}

// Dedups webhook deliveries per gateway so a duplicate or replayed delivery can never be
// processed twice — this is the idempotency guard for POST /payments/webhook/:gateway.
model ProcessedWebhookEvent {
  gateway    String
  eventId    String   @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@id([gateway, eventId])
  @@map("processed_webhook_events")
}

// Per-merchant tunables for the COD risk rules engine. Every field has a sensible default
// so a merchant that never configures this still gets a working engine.
model CodRiskConfig {
  merchantId                 String   @id @map("merchant_id")
  merchant                   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  highValueThresholdCents    Int      @default(500000) @map("high_value_threshold_cents")
  lowAddressQualityThreshold Int      @default(50) @map("low_address_quality_threshold")
  riskyHourStart             Int      @default(0) @map("risky_hour_start")
  riskyHourEnd               Int      @default(5) @map("risky_hour_end")
  velocityThreshold          Int      @default(3) @map("velocity_threshold")
  lowBandMax                 Int      @default(39) @map("low_band_max")
  mediumBandMax              Int      @default(69) @map("medium_band_max")
  // Pincodes/phone hashes below are merchant-defined and never shown to any other
  // merchant — see CodRiskService, which only ever emits the generic reason string
  // "merchant blocklist match", never the matched value itself.
  highRtoPincodes            String[] @default([]) @map("high_rto_pincodes")
  blockedPincodes            String[] @default([]) @map("blocked_pincodes")
  blockedPhoneHashes         String[] @default([]) @map("blocked_phone_hashes")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("cod_risk_configs")
}

// One row per scoring call — the audit trail: exactly what rule version, inputs, and
// reasons produced this decision. `inputs` is scoped to this one order/shopper only, so
// there's nothing here that could ever leak another merchant's data.
model CodRiskDecision {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantId  String   @map("merchant_id")
  score       Int
  band        String
  action      String
  reasons     Json
  ruleVersion String   @map("rule_version")
  inputs      Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cod_risk_decisions")
  @@index([orderId])
  @@index([merchantId])
}

// Feeds the labeled dataset for a future model — delivered vs RTO per order. The model
// itself is explicitly out of scope for this stage; this table just makes the labels
// exist somewhere once Stage 9+ wants to build one.
model CodRiskOutcome {
  id         String   @id @default(uuid())
  orderId    String   @unique @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  delivered  Boolean
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@map("cod_risk_outcomes")
}
